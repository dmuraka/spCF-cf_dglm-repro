    given-names: Daisuke
    email: dmuraka@ism.ac.jp
    affiliation: >-
      Department of Fundamental Statistical Mathematics, Institute of
      Statistical Mathematics, Japan
    orcid: "https://orcid.org/0000-0002-9544-9542"
keywords:
  - coarse-to-fine spatiotemporal modeling
  - spatiotemporal prediction
  - generalized linear mixed model
  - scalability
  - reproducibility
repository-code: "https://github.com/dmuraka/spCF-cf_dglm-repro"
